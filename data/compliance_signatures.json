  "llms_txt_specs": {
    "standard_path": "/llms.txt",
    "full_path": "/llms-full.txt",
    "format": "Markdown",
    "required_sections": [
      "H1 Title (# Domain or Company)",
      "Blockquote summary (> Brief explanation for LLMs)",
      "Navigation / Doc links with markdown lists"
    ]
  },
  "legal_mandatory_fields_fr": [
    "siren_or_siret",
    "company_legal_name",
    "registered_office_address",
    "publication_director",
    "web_host_identity_and_contact",
    "vat_number_if_applicable"
  ],
  "scoring_weights": {
    "rgpd": {
      "has_legal_page": 25,
      "has_siret_displayed": 25,
      "has_vat_displayed": 15,
      "has_host_information": 15,
      "respects_cookie_consent_before_tracking": 20
    },
    "ai_search": {
      "has_llms_txt": 30,
      "has_llms_full_txt": 10,
      "allows_search_ai_bots": 25,
      "has_schema_org_jsonld": 20,
      "has_api_or_openapi_spec": 15
    }
  }
